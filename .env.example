# Vercel environment variables for the Runway 90 backend.
# Never put real values in this file or in the iOS target.
AUTH0_DOMAIN=skmpe.us.auth0.com
AUTH0_AUDIENCE=https://YOUR_RUNWAY90_API_IDENTIFIER
TIGER_DATA_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
GEMINI_API_KEY=replace-in-Vercel
GEMINI_MODEL=gemini-3.6-flash
BACKBOARD_API_KEY=replace-in-Vercel
BACKBOARD_BASE_URL=https://app.backboard.io/api
