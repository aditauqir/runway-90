<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Secrets.plist (same folder) and fill in real values.
	     Secrets.plist is git-ignored. Every key is OPTIONAL — the app runs
	     with labelled demo fallbacks when a key is missing. -->
	<key>GEMINI_API_KEY</key>
	<string>YOUR_GEMINI_API_KEY</string>
	<key>BACKBOARD_API_KEY</key>
	<string>YOUR_BACKBOARD_API_KEY</string>
	<key>TIGER_DATA_URL</key>
	<string>postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require</string>
	<key>AUTH0_DOMAIN</key>
	<string>YOUR_TENANT.us.auth0.com</string>
	<key>AUTH0_CLIENT_ID</key>
	<string>YOUR_AUTH0_CLIENT_ID</string>
</dict>
</plist>
